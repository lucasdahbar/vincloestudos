# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto.
# `.env.local` esta no .gitignore e nunca vai para o repositorio.
#
# Onde encontrar cada valor:
#   Supabase → seu projeto → Project Settings → API

# URL do projeto. Formato: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon / publishable). Pode aparecer no navegador — o RLS
# do banco e quem protege os dados, nao o segredo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role. IGNORA o RLS por completo.
# Usada apenas no servidor, pelo formulario publico de presenca, que valida
# um token proprio antes de escrever. NUNCA pode chegar ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar: desligado ate haver credenciais (ver spec, secao 6).
# Com isso em `false`, as aulas sao materializadas pela recorrencia
# cadastrada na propria turma.
GOOGLE_CALENDAR_ATIVO=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
